---
import '../styles/global.css';
import { nav, href } from '../lib';

interface Props { title: string; description: string; updated?: Date }
const { title, description, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = await nav();
const current = Astro.url.pathname;
const pageTitle = title === 'So what now?' ? title : `${title} — So what now?`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={`${base}/`}>So what now?</a>
      <span class="tag">Agentic AI for working web developers. No hype, no denial.</span>
    </header>
    <div class="wrap">
      {groups.length > 0 && (
        <nav class="side" aria-label="Pages">
          {groups.map(([section, pages]) => (
            <div class="group">
              {section && <p class="section">{section}</p>}
              <ul>
                {pages.map((p) => (
                  <li><a href={href(p)} aria-current={current === href(p) ? 'page' : undefined}>{p.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}
      <main class="prose">
        <slot />
        {updated && <p class="updated">Updated {updated.toISOString().slice(0, 10)}</p>}
      </main>
    </div>
    <footer class="foot">
      <a href="https://github.com/easingthemes/so-what-now">Source on GitHub</a> · Dragan Filipovic
    </footer>
  </body>
</html>
